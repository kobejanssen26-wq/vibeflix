# Copy this file to `.env` and fill in ONE of the two values below.
# Never commit your real `.env` file. The key stays on the server (it is never
# bundled into the browser code). Leave both empty to run in demo mode.

# Option A: TMDB "API Key" (v3 auth) – https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Option B: TMDB "API Read Access Token" (v4 auth, long JWT string)
TMDB_READ_ACCESS_TOKEN=

# Port for the production server (`npm start`). Optional.
PORT=8080
